# Copy to .env and fill in real values. .env is gitignored; .env.example is not.

# Decision model for the jev_check guard (docs/decisions.md). Any /v1/systemone endpoint works.
# Today that is Clef on the Mac Studio's Ollama. Without DECISION_BASE_URL, jev_check returns an error, never a decision.
DECISION_BASE_URL=http://127.0.0.1:11434
# From another machine on the tailnet: http://gg-macstudio:11434
# clef (default) or clef-flash.
DECISION_MODEL=clef
# Bearer token, needed only for a hosted endpoint. Ollama ignores it.
DECISION_API_KEY=
#DECISION_TIMEOUT_MS=120000
# Use a different rubric folder instead of .pi/rubrics.
#DECISION_RUBRIC_DIR=
