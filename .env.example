# Copy to .env and fill in real values. .env is gitignored; .env.example is not.

# Jev (TypeSafe AI) — the SDKs and the extension read this exact variable name. Docs: docs/jev/
TYPESAFE_API_KEY=

# Local Jev — the readout server on the DGX Spark (backs/readout in orchestratorai-jev). Leave unset for hosted Jev.
# TYPESAFE_MODEL is a readout alias: corroborate-poe (djev + nimble + decider, product of experts), djev-26b-nvfp4,
# nimble-9b, decider-2b, qwen3.5-4b, corroborate-vision, ... — see backs/readout/models.yaml. Fail-closed if unreachable.
#TYPESAFE_BASE_URL=http://100.120.203.62:8000
#TYPESAFE_MODEL=corroborate-poe
#TYPESAFE_TIMEOUT_MS=120000
